{
  "name": "legacy",
  "title": "Legacy account, never migrated",
  "account_id": "121212121212",
  "region": "us-west-1",
  "severity": "high",
  "summary": "No SSO, no roles worth the name, and access keys from 2018. Two identities reach administrator in a single step.",
  "signature_source": "developer",
  "policies": {
    "admin": {
      "Name": "AdministratorAccess",
      "Document": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "*", "Resource": "*" }] }
    },
    "read-only": {
      "Name": "ReadOnlyAccess",
      "Document": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["*:Get*", "*:List*", "*:Describe*"], "Resource": "*" }] }
    },
    "backup": {
      "Name": "backup-rotate-keys",
      "Document": {
        "Version": "2012-10-17",
        "Statement": [
          { "Effect": "Allow", "Action": ["iam:CreateAccessKey", "iam:ListAccessKeys", "iam:UpdateAccessKey"], "Resource": "arn:aws:iam::121212121212:user/legacy-admin" }
        ]
      }
    },
    "helpdesk": {
      "Name": "helpdesk-policy",
      "Document": {
        "Version": "2012-10-17",
        "Statement": [
          { "Effect": "Allow", "Action": ["iam:AttachUserPolicy", "iam:ListUsers"], "Resource": "*" }
        ]
      }
    },
    "developer": {
      "Name": "developer-policy",
      "Document": {
        "Version": "2012-10-17",
        "Statement": [
          { "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::121212121212:role/legacy-role" },
          { "Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*" }
        ]
      }
    },
    "legacy-role": {
      "Name": "legacy-role-policy",
      "Document": {
        "Version": "2012-10-17",
        "Statement": [
          { "Effect": "Allow", "Action": ["ec2:*", "s3:*"], "Resource": "*" },
          { "Effect": "Allow", "Action": "iam:CreatePolicyVersion", "Resource": "arn:aws:iam::121212121212:policy/legacy-role-policy" }
        ]
      }
    }
  },
  "identities": [
    { "id": "svc-backup", "name": "svc-backup", "label": "Backup service", "kind": "user", "attached": ["backup"], "note": "Nightly backup job. Rotates the administrator key." },
    { "id": "legacy-admin", "name": "legacy-admin", "label": "Legacy admin", "kind": "user", "attached": ["admin"], "note": "The account's original administrator. Console login, no MFA." },
    { "id": "helpdesk", "name": "helpdesk", "label": "Helpdesk", "kind": "user", "attached": ["helpdesk"], "note": "Attaches policies when someone files a ticket." },
    { "id": "developer", "name": "developer", "label": "Developer", "kind": "user", "attached": ["developer"], "note": "Launches test instances with the legacy role." },
    { "id": "legacy-role", "name": "legacy-role", "label": "Legacy role", "kind": "role", "attached": ["legacy-role"], "trust": ["arn:aws:iam::121212121212:root", "ec2.amazonaws.com"], "note": "Instance profile from 2018. Can publish new versions of its own policy." },
    { "id": "intern", "name": "intern", "label": "Intern", "kind": "user", "attached": ["read-only"], "note": "Read-only." },
    { "id": "reports", "name": "reports", "label": "Reporting", "kind": "user", "attached": ["read-only"], "note": "Read-only." },
    { "id": "contractor", "name": "contractor", "label": "Contractor", "kind": "user", "attached": ["read-only"], "note": "Read-only, still active." }
  ],
  "resources": []
}
